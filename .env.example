# Awaaz-e-Awam environment variables
# Copy this file to `.env.local` and fill in your own values. Never commit secrets.

# Turns mock mode on/off: "mock" = canned responses, "live" = real API calls.
AI_MODE=mock

# Which AI backend serves scanning + extraction: "deepseek" (default) or "gemini".
# Useful when DeepSeek is out of balance or you want to compare providers.
AI_PROVIDER=deepseek

# DeepSeek API key (form scanning + answer extraction). Create at platform.deepseek.com
DEEPSEEK_API_KEY=

# Gemini API key (speech-to-text + optional AI backend). Get at aistudio.google.com
GEMINI_API_KEY=