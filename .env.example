# AI_MODE: "mock" exercises the full flow with zero API calls (recommended for dev);
#          "live" calls the real providers below.
AI_MODE=
# AI_PROVIDER: "gemini" | "deepseek" — default text/vision provider (auto-chooses by key when empty).
AI_PROVIDER=
# Server-only secret keys. Never commit real values; they live in .env.local.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
