# AI_MODE: "mock" exercises the full flow with zero API calls (recommended for dev);
#          "live" calls the real providers below.
AI_MODE=
# AI_PROVIDER: "gemini" | "deepseek" — default text/vision provider (auto-chooses by key when empty).
#              Only consulted when DATA_PATH=demo.
AI_PROVIDER=
# DATA_PATH: "sensitive" = real citizen PII; only PII-safe providers (Groq) are allowed and the
#            router fails closed — Gemini/DeepSeek must never receive real data.
#            "demo" (default) = synthetic data only; gemini/deepseek are allowed.
DATA_PATH=
# Server-only secret keys. Never commit real values; they live in .env.local.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
